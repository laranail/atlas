{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "concat_space": {
            "spacing": "one"
        },
        "phpdoc_align": {
            "align": "left"
        }
    },
    "exclude": [
        "vendor",
        "resources/data"
    ],
    "notPath": [
        "resources/data/countries.php",
        "src/Enums/Country.php",
        "src/Enums/Currency.php",
        "src/Enums/Language.php"
    ]
}
